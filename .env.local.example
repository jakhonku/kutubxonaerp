# Supabase — Project Settings > API bo'limidan oling
# DIQQAT: Bu yerga HAQIQIY kalitlarni yozmang. Haqiqiy qiymatlar faqat
# .env.local faylida bo'lishi kerak (u .gitignore orqali git'ga tushmaydi).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — FAQAT server tomonida (RLS aylanib o'tadi). Hech qachon clientga chiqarmang!
# Bu kalit bazaga to'liq admin huquqi beradi — hech qachon commit qilmang.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# «БЕЛЕС» kitobxonlik o'yini moduli — ASOSIY ("master") kalit.
# Bo'sh yoki false bo'lsa modul umuman yo'q: /beles/* marshrutlari 404
# qaytaradi, navigatsiyada havola ko'rinmaydi.
# true bo'lganda kundalik o'chirib-yoqish kutubxonachi panelidagi tugma
# orqali bajariladi (beles_settings jadvali) — redeploy talab qilinmaydi.
BELES_ENABLED=false
NEXT_PUBLIC_BELES_ENABLED=false
